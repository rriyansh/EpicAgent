
PORT=4000
NODE_ENV=development

# Session secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# 32-byte hex key for encrypting API keys at rest
ENCRYPTION_KEY=change-me-64-hex-chars-this-encrypts-user-api-keys

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional server-managed fallback key for the OpenAI provider
OPENAI_API_KEY=

# Optional: per-provider cooldown in ms when a key fails
KEY_COOLDOWN_MS=60000
