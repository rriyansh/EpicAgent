# Backend
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://epic:epic@localhost:5432/epic_agent
JWT_SECRET=replace-with-32-plus-random-characters
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace-with-32-plus-random-characters
API_KEY_PEPPER=replace-with-another-32-plus-random-secret
CORS_ORIGIN=http://localhost:5173

# Supabase Auth (anon key only, never the service-role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
